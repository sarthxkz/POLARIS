# POLARIS — environment. Copy to .env.local (dev) or .env (production). Never commit real values.

# Public origin of the site, used for absolute URLs and the CORS allow-list.
SITE_URL=http://localhost:3000

# Contact string sent in the User-Agent to public data providers (good citizenship; required by some).
PROVIDER_CONTACT=polaris (https://example.org/contact)

# OpenSky Network OAuth2 client credentials (optional). Without them the site uses anonymous access:
# 400 credits/day, so the global aircraft snapshot refreshes about every 15 minutes.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Override the aircraft refresh interval in seconds (default: 900 anonymous, 120 authenticated).
OPENSKY_REFRESH_SECONDS=
